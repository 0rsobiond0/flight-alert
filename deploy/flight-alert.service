[Unit]
Description=Flight Alert search worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=flight-alert
Group=flight-alert
WorkingDirectory=/opt/flight-alert
EnvironmentFile=/etc/flight-alert/flight-alert.env
ExecStart=/opt/flight-alert/.venv/bin/python -m flight_alert --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flight-alert

[Install]
WantedBy=multi-user.target
