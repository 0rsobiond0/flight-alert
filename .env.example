# Search scope
ORIGINS=MXP,BGY,LIN
PASSENGERS=2
MIN_NIGHTS=2
MAX_NIGHTS=4
MAX_TOTAL_EUR=100
SEARCH_UNTIL=2027-03-31
CHECK_INTERVAL_HOURS=6

# Provider — only "ryanair" is supported currently.
PROVIDER=ryanair

# Ryanair public SEO pages for the routes you care about (comma-separated).
# Format: https://www.ryanair.com/ie/en/flights/flights-from-<origin>-to-<destination>
# Leave empty to auto-discover from sitemap (slower, more network traffic).
# Example: https://www.ryanair.com/ie/en/flights/flights-from-bergamo-to-athens,https://www.ryanair.com/ie/en/flights/flights-from-bergamo-to-thessaloniki
PROVIDER_URLS=

# Max Ryanair route pages to fetch per cycle when using sitemap discovery.
MAX_ROUTES=100

# SQLite state database path (must be writable by the service user).
STATE_DB=/var/lib/flight-alert/offers.db

# Keep true while testing; no Telegram credentials are required in dry-run mode.
DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
